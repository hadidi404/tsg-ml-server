# Override GitHub language detection
# Exclude auto-generated Flutter platform code from language statistics

# Linux platform code
linux/** linguist-vendored
# Windows platform code  
windows/** linguist-vendored
# macOS platform code
macos/** linguist-vendored
# iOS platform code
ios/** linguist-vendored
# Android platform code (except custom code)
android/** linguist-vendored
# Web platform code
web/** linguist-vendored

# Build outputs
build/** linguist-generated
.dart_tool/** linguist-generated

# Mark Dart as the primary language
*.dart linguist-language=Dart
