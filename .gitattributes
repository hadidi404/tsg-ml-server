# Mark auto-generated Flutter platform code as vendored
# This prevents it from skewing language statistics when you add Dart code

# Auto-generated Flutter runners (don't edit these manually)
linux/flutter/** linguist-vendored
windows/flutter/** linguist-vendored
macos/Flutter/** linguist-vendored
macos/Runner/GeneratedPluginRegistrant.* linguist-vendored
ios/Flutter/** linguist-vendored
ios/Runner/GeneratedPluginRegistrant.* linguist-vendored
android/app/src/main/java/**/GeneratedPluginRegistrant.* linguist-vendored
web/flutter_bootstrap.js linguist-vendored

# Build outputs
build/** linguist-generated
.dart_tool/** linguist-generated

# Your Dart code (what you actually write)
*.dart linguist-language=Dart linguist-detectable=true
